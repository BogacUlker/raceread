      "segments": [
        {
          "s": 11.64,
          "e": 12.7,
          "t": "What an afternoon.",
          "tr": "Ne öğleden sonraydı."
        },
        {
          "s": 12.86,
          "e": 13.84,
          "t": "What an adventure.",
          "tr": "Ne macera."
        },
        {
          "s": 14.16,
          "e": 15.26,
          "t": "We secured the championship.",
          "tr": "Şampiyonluğu garantiledik."
        },
        {
          "s": 15.44,
          "e": 16.54,
          "t": "I think it's most important.",
          "tr": "Bence en önemlisi bu."
        },
        {
          "s": 18.26,
          "e": 19.14,
          "t": "Well done, everybody.",
          "tr": "Herkese tebrikler."
        },
        {
          "s": 19.54,
          "e": 22.82,
          "t": "It's, yeah, great to see what we've achieved this year.",
          "tr": "Bu yıl başardıklarımızı görmek harika."
        }
      ]
    },
    {
      "driver": "VER",
