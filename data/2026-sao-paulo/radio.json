      "segments": [
        {
          "s": 1.7,
          "e": 2.96,
          "t": "Well done, mate. Well done.",
          "tr": "Tebrikler dostum. Tebrikler."
        },
        {
          "s": 6.4,
          "e": 7.08,
          "t": "Nicely done.",
          "tr": "Harika iş."
        },
        {
          "s": 9.44,
          "e": 11.42,
          "t": "Well done, guys. Well done. You all deserve it.",
          "tr": "Tebrikler çocuklar. Tebrikler. Hepiniz bunu hak ettiniz."
        },
        {
          "s": 20.12,
          "e": 22.52,
          "t": "Let's keep it going, please. Let's keep the work up.",
          "tr": "Lütfen böyle devam edelim. Çalışmayı sürdürelim."
        },
        {
          "s": 23.12,
          "e": 25.94,
          "t": "Zach must have done the right rain dance for his birthday last night.",
          "tr": "Zak dün gece doğum günü için doğru yağmur dansını yapmış olmalı."
        },
        {
          "s": 26.24,
          "e": 27.84,
          "t": "Oh, yes. Happy birthday, Zachary.",
          "tr": "Ah, evet. Doğum günün kutlu olsun, Zachary."
        },
        {
          "s": 28.56,
          "e": 32.38,
          "t": "I know you love being called Zachary, so happy birthday Zachary.",
          "tr": "Zachary diye çağrılmayı sevdiğini biliyorum, o yüzden doğum günün kutlu olsun Zachary."
        }
      ]
    },
